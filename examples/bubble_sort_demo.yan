# 冒泡排序 - 基础版本

# 定义数组
定义变量arr为[5, 3, 8, 4, 2, 1, 9, 6]

# 输出原始数组
输出 "原始数组："
输出 arr

# 简单的排序演示
输出 "开始排序..."

# 比较第一对元素
定义变量a为arr[0]
定义变量b为arr[1]
输出 "比较 arr[0] 和 arr[1]:"
输出 a
输出 b

如果 a 大于 b 则
    输出 "需要交换"
否则
    输出 "不需要交换"

# 比较第二对元素
定义变量c为arr[1]
定义变量d为arr[2]
输出 "比较 arr[1] 和 arr[2]:"
输出 c
输出 d

如果 c 大于 d 则
    输出 "需要交换"
否则
    输出 "不需要交换"

输出 "排序演示完成"
