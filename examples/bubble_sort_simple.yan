# 冒泡排序 - 简化版本

# 定义数组
定义变量arr为[5, 3, 8, 4, 2, 1, 9, 6]

# 输出原始数组
输出 "原始数组："
输出 arr

# 冒泡排序实现
定义变量n为8
定义变量i为0

# 外层循环
循环 7 次执行
    定义变量j为0
    # 内层循环
    循环 7 次执行
        # 比较相邻元素
        定义变量a为arr[j]
        定义变量b为arr[j加1]
        
        # 如果a > b，交换
        如果 a 大于 b 则
            定义变量temp为arr[j]
            # 注意：这里需要数组赋值功能
            输出 "交换"
        否则
            输出 "不交换"
        
        定义变量j为j加1
    
    定义变量i为i加1

# 输出排序后的数组
输出 "排序完成"
