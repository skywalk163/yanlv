# 言律语言示例程序 - 文件操作

# 写入文件
写入文件 "test.txt" "这是测试内容"
输出 "文件已写入"

# 读取文件
读取文件 "test.txt" 为 内容
输出 "文件内容："
输出 内容

# 检查文件存在
文件存在 "test.txt"
输出 "文件存在检查完成"

# 获取文件大小
文件大小 "test.txt"
输出 "文件大小已获取"

# 获取文件名
文件名 "C:/Users/test/data.txt"
输出 "文件名已获取"

# 获取目录名
目录名 "C:/Users/test/data.txt"
输出 "目录名已获取"

# 追加文件
追加文件 "test.txt" "\n这是追加的内容"
输出 "内容已追加"

# 再次读取
读取文件 "test.txt" 为 新内容
输出 "新内容："
输出 新内容
