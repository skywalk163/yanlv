#lang racket

;; 言律语言 Racket 原型 - 简化版
;; 演示如何用Racket实现言律语法

;; ========================================
;; 1. 基础语法定义
;; ========================================

;; 输出语句
(define-syntax 输出
  (syntax-rules ()
    [(_ 内容) (displayln 内容)]))

;; 变量定义
(define-syntax 定义
  (syntax-rules (变量 为)
    [(_ 变量 名 为 值)
     (define 名 值)]))

;; 条件判断
(define-syntax 如果
  (syntax-rules (则 否则)
    [(_ 条件 则 真分支)
     (when 条件 真分支)]
    [(_ 条件 则 真分支 否则 假分支)
     (if 条件 真分支 假分支)]))

;; 循环
(define-syntax 对于
  (syntax-rules (从 到)
    [(_ 变量 从 起点 到 终点 主体 ...)
     (for ([变量 (in-range 起点 (+ 终点 1))])
       主体 ...)]))

;; ========================================
;; 2. 比较运算符（中文版）
;; ========================================

(define-syntax 大于
  (syntax-rules ()
    [(_ x y) (> x y)]))

(define-syntax 小于
  (syntax-rules ()
    [(_ x y) (< x y)]))

(define-syntax 等于
  (syntax-rules ()
    [(_ x y) (= x y)]))

;; ========================================
;; 3. 算术运算符（中文版）
;; ========================================

(define-syntax 加
  (syntax-rules ()
    [(_ x y) (+ x y)]))

(define-syntax 减
  (syntax-rules ()
    [(_ x y) (- x y)]))

(define-syntax 乘
  (syntax-rules ()
    [(_ x y) (* x y)]))

(define-syntax 除
  (syntax-rules ()
    [(_ x y) (/ x y)]))

;; ========================================
;; 4. 演示示例
;; ========================================

;; 示例1: 基础输出
(输出 "=== 示例1: 基础输出 ===")
(输出 "你好，言律语言！")

;; 示例2: 变量定义
(输出 "\n=== 示例2: 变量定义 ===")
(定义 变量 x 为 10)
(定义 变量 y 为 20)
(输出 (string-append "x = " (number->string x)))
(输出 (string-append "y = " (number->string y)))

;; 示例3: 条件判断
(输出 "\n=== 示例3: 条件判断 ===")
(定义 变量 温度 为 30)
(如果 (大于 温度 28) 则
      (输出 "开启空调制冷"))
(如果 (小于 温度 20) 则
      (输出 "开启空调制热")
      否则
      (输出 "温度适宜"))

;; 示例4: 循环
(输出 "\n=== 示例4: 循环 ===")
(输出 "从1到5:")
(对于 i 从 1 到 5
      (输出 i))

;; 示例5: 算术运算
(输出 "\n=== 示例5: 算术运算 ===")
(定义 变量 a 为 10)
(定义 变量 b 为 3)
(输出 (string-append "a + b = " (number->string (加 a b))))
(输出 (string-append "a - b = " (number->string (减 a b))))
(输出 (string-append "a * b = " (number->string (乘 a b))))
(输出 (string-append "a / b = " (number->string (除 a b))))

;; ========================================
;; 5. 高级示例：冒泡排序
;; ========================================

(输出 "\n=== 高级示例: 冒泡排序 ===")

;; 交换列表元素
(define (交换 lst i j)
  (let ([temp (list-ref lst i)])
    (let ([lst1 (list-set lst i (list-ref lst j))])
      (list-set lst1 j temp))))

;; 冒泡排序
(define (冒泡排序 lst)
  (define 长度 (length lst))
  (for ([i (in-range 长度)])
    (for ([j (in-range (- 长度 i 1))])
      (when (> (list-ref lst j) (list-ref lst (+ j 1)))
        (set! lst (交换 lst j (+ j 1))))))
  lst)

;; 测试排序
(定义 变量 数据 为 '(5 3 8 4 2 1 9 6))
(输出 "原始数据:")
(输出 数据)
(定义 变量 排序后 为 (冒泡排序 数据))
(输出 "排序后:")
(输出 排序后)

;; ========================================
;; 6. 状态流示例
;; ========================================

(输出 "\n=== 状态流示例 ===")

(定义 变量 订单状态 为 "已付款")

;; 状态转换
(define (处理订单 状态)
  (cond
    [(string=? 状态 "已付款") (输出 "准备发货")]
    [(string=? 状态 "已发货") (输出 "通知用户")]
    [(string=? 状态 "已签收") (输出 "更新库存")]
    [else (输出 "未知状态")]))

(处理订单 订单状态)

;; ========================================
;; 7. 函数定义示例
;; ========================================

(输出 "\n=== 函数定义示例 ===")

;; 定义函数
(define (阶乘 n)
  (if (<= n 1)
      1
      (* n (阶乘 (- n 1)))))

(输出 "5的阶乘:")
(输出 (阶乘 5))

