{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YanLv",
  "scopeName": "source.yanlv",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.yanlv",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.yanlv",
          "match": "#.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.yanlv",
          "match": "\\b(如果|否则|当|循环|执行|结束|定义|函数|参数|调用|返回|输出|设置|添加|删除|长度|查找|替换|分割|子串|尝试|捕获|抛出|异常|最终|模块|导入|导出|从|为|命名空间)\\b"
        },
        {
          "name": "keyword.other.yanlv",
          "match": "\\b(变量|数组|为|是|则|时|次|每个|直到|在)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.yanlv",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.yanlv",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.yanlv",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.yanlv",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.yanlv",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.yanlv",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.yanlv",
          "match": "(加|减|乘|除|取余|等于|不等于|大于|小于|大于等于|小于等于|且|或|非|\\+|-|\\*|/|%|==|!=|>|<|>=|<=|&&|\\|\\||!)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.yanlv",
          "match": "\\b(函数|调用)\\s+([a-zA-Z_\\u4e00-\\u9fa5][a-zA-Z0-9_\\u4e00-\\u9fa5]*)\\b",
          "captures": {
            "2": {
              "name": "entity.name.function.yanlv"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.yanlv",
          "match": "\\b[a-zA-Z_\\u4e00-\\u9fa5][a-zA-Z0-9_\\u4e00-\\u9fa5]*\\b"
        }
      ]
    }
  }
}
